{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.koda-ai-studio/agent-bom",
  "description": "AI supply-chain BOM: agents, MCP servers, packages and recorded reach. Scan and investigate via MCP.",
  "title": "agent-bom",
  "version": "0.112.1",
  "repository": {
    "url": "https://github.com/koda-ai-studio/agent-bom",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "agent-bom",
      "version": "0.112.1",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "uvx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "isRepeated": false
        },
        {
          "type": "positional",
          "value": "server",
          "isRepeated": false
        }
      ],
      "environmentVariables": [
        {
          "name": "NVD_API_KEY",
          "description": "NVD API key for higher rate limits on vulnerability enrichment",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
