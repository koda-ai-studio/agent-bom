{
  "mcpServers": {
    "agent-bom": {
      "command": "uv",
      "args": ["run", "--frozen", "--isolated", "--project", "${CLAUDE_PLUGIN_ROOT}", "agent-bom", "mcp", "server"],
      "env": { "AGENT_BOM_MCP_WORKSPACE_ROOTS": "${CLAUDE_PROJECT_DIR}", "AGENT_BOM_MCP_LIVE_INTROSPECTION": "0", "GITHUB_TOKEN": "", "GH_TOKEN": "", "NVD_API_KEY": "" }
    },
    "agent-bom-audit": {
      "command": "uv",
      "args": ["run", "--frozen", "--isolated", "--project", "${CLAUDE_PLUGIN_ROOT}", "agent-bom", "mcp", "server", "--profile", "audit"],
      "env": { "AGENT_BOM_MCP_WORKSPACE_ROOTS": "${CLAUDE_PROJECT_DIR}", "AGENT_BOM_MCP_LIVE_INTROSPECTION": "0", "GITHUB_TOKEN": "", "GH_TOKEN": "", "NVD_API_KEY": "" }
    }
  }
}
