{
  "name": "ui",
  "version": "0.112.1",
  "private": true,
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": "^22.22.2 || >=24.15.0 <25"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev --webpack",
    "build": "node scripts/run-next.mjs build --webpack",
    "start": "next start",
    "bundle:check": "node scripts/assert-install-matches-lockfile.mjs && node scripts/check-bundle-budget.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node --import ./scripts/minimatch-compat.mjs node_modules/eslint/bin/eslint.js",
    "lock:normalize": "npm install --package-lock-only --ignore-scripts",
    "test:runtime-proxy": "node scripts/smoke-runtime-api-proxy.mjs",
    "test:e2e": "node scripts/assert-install-matches-lockfile.mjs && node scripts/assert-build-is-current.mjs && playwright test",
    "test:static-demo": "playwright test --config playwright.static-demo.config.ts",
    "verify:toolchain": "node scripts/verify-toolchain.mjs && node --test scripts/next-root-dirs.test.mjs && node --import ./scripts/minimatch-compat.mjs --test scripts/tooling-glob-compat.test.mjs",
    "headers:sync": "node scripts/sync-vercel-headers.mjs",
    "headers:check": "node scripts/sync-vercel-headers.mjs --check",
    "capture:product-proof": "node scripts/capture-product-proof.mjs",
    "capture:inputs-digest": "node scripts/refresh-capture-inputs-digest.mjs",
    "capture:inputs-digest:check": "node scripts/refresh-capture-inputs-digest.mjs --check",
    "codegen:graph-schema": "node scripts/codegen-graph-schema.mjs",
    "codegen:graph-schema:check": "node scripts/codegen-graph-schema.mjs --check",
    "codegen:api-schema": "node --import ./scripts/minimatch-compat.mjs node_modules/openapi-typescript/bin/cli.js ../docs/openapi/v1.json -o lib/api-schema.generated.ts",
    "codegen:api-schema:check": "node --import ./scripts/minimatch-compat.mjs node_modules/openapi-typescript/bin/cli.js ../docs/openapi/v1.json -o lib/api-schema.generated.ts --check",
    "test": "vitest",
    "test:run": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "install:verify": "node scripts/assert-install-matches-lockfile.mjs",
    "build:verify": "node scripts/assert-build-is-current.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@tanstack/react-table": "9.2.6",
    "@tanstack/react-virtual": "^3.14.13",
    "@xyflow/react": "^12.12.0",
    "graphology": "^0.26.0",
    "lucide-react": "^1.52.0",
    "next": "^16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "sigma": "^3.0.3"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "postcss": "8.5.23",
    "sharp": "^0.35.5",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.17",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "minimatch": "11.0.1",
    "glob": "14.0.2"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.1",
    "@playwright/test": "^1.63.0",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/dagre": "^0.7.54",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.4.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^30.1.2",
    "lightningcss": "1.33.0",
    "openapi-typescript": "7.13.0",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
