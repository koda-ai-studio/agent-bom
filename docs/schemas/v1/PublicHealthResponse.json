{
  "description": "Non-sensitive liveness and UI bootstrap posture.",
  "properties": {
    "auth_configured": {
      "default": false,
      "title": "Auth Configured",
      "type": "boolean"
    },
    "auth_required": {
      "default": true,
      "title": "Auth Required",
      "type": "boolean"
    },
    "configured_auth_modes": {
      "items": {
        "type": "string"
      },
      "title": "Configured Auth Modes",
      "type": "array"
    },
    "demo_seed": {
      "anyOf": [
        {
          "enum": [
            "pending",
            "complete"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Demo estate mode only: 'pending' while the demo seed is still writing, so early reads see partial data; 'complete' once it has landed. Null outside demo mode. Liveness stays 200 either way; /readyz returns 503 while pending.",
      "title": "Demo Seed"
    },
    "status": {
      "default": "ok",
      "title": "Status",
      "type": "string"
    },
    "unauthenticated_allowed": {
      "default": false,
      "title": "Unauthenticated Allowed",
      "type": "boolean"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "version"
  ],
  "title": "PublicHealthResponse",
  "type": "object"
}
