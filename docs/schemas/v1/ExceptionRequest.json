{
  "additionalProperties": false,
  "description": "A vulnerability exception (``vuln_id`` + ``package_name``) or an IaC exception (``iac_rule_id`` + path/resource).",
  "properties": {
    "expires_at": {
      "default": "",
      "title": "Expires At",
      "type": "string"
    },
    "iac_path": {
      "default": "",
      "description": "Glob on the finding's repository-relative path",
      "maxLength": 400,
      "title": "Iac Path",
      "type": "string"
    },
    "iac_resource": {
      "additionalProperties": true,
      "description": "Resource selector: kind, name, namespace, labels",
      "title": "Iac Resource",
      "type": "object"
    },
    "iac_rule_id": {
      "default": "",
      "description": "IaC rule id, e.g. K8S-001 (IaC exceptions only)",
      "maxLength": 80,
      "title": "Iac Rule Id",
      "type": "string"
    },
    "package_name": {
      "default": "",
      "maxLength": 400,
      "title": "Package Name",
      "type": "string"
    },
    "reason": {
      "default": "",
      "maxLength": 2000,
      "title": "Reason",
      "type": "string"
    },
    "requested_by": {
      "default": "",
      "title": "Requested By",
      "type": "string"
    },
    "server_name": {
      "default": "",
      "title": "Server Name",
      "type": "string"
    },
    "tenant_id": {
      "default": "default",
      "title": "Tenant Id",
      "type": "string"
    },
    "vuln_id": {
      "default": "",
      "maxLength": 200,
      "title": "Vuln Id",
      "type": "string"
    }
  },
  "title": "ExceptionRequest",
  "type": "object"
}
